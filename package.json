{
	"name": "vaulter",
	"version": "1.0.3",
	"description": "Displays vault statistics like note count and allows toggling display in the status bar",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"vault stats",
		"note count"
	],
	"author": "Alessandro Chitarrini",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
